# Copy this file to .env and fill in your key:
#   cp .env.example .env        (Windows: copy .env.example .env)
#
# A free key is available at https://aistudio.google.com, and the free tier is
# enough to try the project. You can also leave GEMINI_API_KEY empty here and
# paste the key later from the app's Settings page; it takes effect immediately.
GEMINI_API_KEY=

# Applies to every document type, not per schema. gemini-3.5-flash is the
# confirmed-working default on the free tier.
DEFAULT_MODEL=gemini-3.5-flash
